# Staging copy for the OSF upload, rebuilt by scripts/stage_osf_upload.py
osf_upload/

# Any backup or variant of a credentialed config, however suffixed.
config/config.main.yaml*
config/*.bak*
*.bak-*

# --- Excluded from the public repository -----------------------------------
